# ── Supabase (Next.js: NEXT_PUBLIC_* untuk variabel client-side) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# ── Mayar Payment (production API: api.mayar.id/hl/v2) ──
PAYMENT_PROVIDER=mayar
MAYAR_API_KEY=mwr_...
MAYAR_IS_SANDBOX=false
# Opsional: timpa base URL (untuk stub uji lokal)
# MAYAR_BASE_URL=http://127.0.0.1:4599/hl/v2
MAYAR_MERCHANT_PHONE=628...
MAYAR_WEBHOOK_SECRET=mwr_...
# Opsional: MAYAR_RESTRICT_PAYMENT_METHOD=true

# ── Auth (NextAuth, jika dipakai) ──
NEXTAUTH_SECRET=...
NEXTAUTH_URL=https://jejakawanapp.vercel.app

# ── Google OAuth (jika dipakai) ──
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
