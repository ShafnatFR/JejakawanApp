# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payment (Mayar) ───────────────────────────────────────
# Provider aktif: "mayar"
PAYMENT_PROVIDER="mayar"
# API key dari dashboard Mayar (web.mayar.id/api-keys), scope Read & Write
MAYAR_API_KEY=""
# "true" = sandbox (api.mayar.io), "false" = produksi (api.mayar.id)
MAYAR_IS_SANDBOX="true"
# Secret webhook — daftarkan URL /api/payments/webhook/mayar?secret=<nilai> ini
# di dashboard Mayar (Integration -> Webhook). Jangan ganti setelah didaftarkan.
MAYAR_WEBHOOK_SECRET=""
# "true" = Mayar menolak paymentMethod yang belum diaktifkan di dashboard
MAYAR_RESTRICT_PAYMENT_METHOD="false"
# Nomor HP merchant — fallback saat pelanggan tidak memberi nomor
# (Mayar mewajibkan field mobile saat membuat tagihan/invoice)
MAYAR_MERCHANT_PHONE=""
# Override base URL (untuk uji lokal dengan scripts/mock-mayar-server.mjs):
#   node scripts/mock-mayar-server.mjs 4599
#   MAYAR_BASE_URL=http://127.0.0.1:4599/hl/v2
MAYAR_BASE_URL=""

# ── OAuth (opsional) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
